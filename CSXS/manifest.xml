<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.ae.tools"
                   ExtensionBundleVersion="2.0.0"
                   Version="6.0">

  <ExtensionList>
    <Extension Id="com.ae.tools.mcp" Version="2.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[0.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="6.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>

    <Extension Id="com.ae.tools.mcp">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel/index.html</MainPath>
          <ScriptPath>./panel/panel.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node is required: the panel talks to the AE MCP Bridge over a local TCP socket. -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE MCP</Menu>
          <Geometry>
            <Size><Height>560</Height><Width>320</Width></Size>
            <MinSize><Height>320</Height><Width>260</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>

</ExtensionManifest>
